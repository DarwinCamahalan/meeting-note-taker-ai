{
  "name": "@cue/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cue BFF (NestJS 11): auth (PKCE + ES256 JWT), sessions, me, documents. Zod schemas are the contract source of truth.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps --env-file-if-exists=../../.env dist/main.js",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@cue/core": "workspace:*",
    "@cue/db": "workspace:*",
    "@cue/observability": "workspace:*",
    "@cue/types": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@workos-inc/node": "^7",
    "drizzle-orm": "^0.36.0",
    "ioredis": "^5.4.1",
    "jose": "^5.9.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^17.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cue/config": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  }
}
