# Cue — secrets & config. Copy to .env and fill in. NEVER commit .env.

# ---- Phase 0 (AI pipeline) ----
# Anthropic API key (Claude — claude-haiku-4-5 streaming cues). REQUIRED.
ANTHROPIC_API_KEY=
# Speech-to-text backend: 'local-whisper' (FREE, offline, on-device whisper.cpp —
# no key; the default) or 'deepgram' (paid cloud). Leave unset for local-whisper.
# STT_PROVIDER=local-whisper
# ggml model for local-whisper: tiny.en | base.en | small.en | medium.en (or a
# path to a .bin). Bigger = more accurate + slower. Default base.en.
# WHISPER_MODEL=base.en
# Deepgram API key — ONLY needed if STT_PROVIDER=deepgram. Left blank = free local STT.
DEEPGRAM_API_KEY=

# ---- Phase 1 (backend services) ----
# Postgres 16 + pgvector connection string (used by @cue/db / drizzle-kit).
DATABASE_URL=postgres://cue:cue@localhost:5432/cue

# JWT signing (dev ES256 keypair). PEM (PKCS#8 private / SPKI public), single-line
# with \n escapes or a base64 blob — loaded by the api service.
# TODO(prod: KMS asymmetric signing per 40-authentication.md §2.3) — do NOT ship
# a raw private key to production; sign via kms:Sign against an ECC_NIST_P256 CMK.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Service ports.
API_PORT=3001
WS_PORT=3002

# ai-orchestrator gRPC address (host:port) that ws-gateway dials.
ORCHESTRATOR_GRPC_ADDR=localhost:50051

# ---- api service (@cue/api) ----
# Runtime mode: development | test | production.
NODE_ENV=development
# Web app origin — used for the PKCE /activate page and the DEFAULT CORS origin.
WEB_BASE_URL=http://localhost:3000
# Extra allowed CORS origins (comma-separated). Set this so a HOSTED api accepts
# the deployed web origin without changing WEB_BASE_URL. Unset ⇒ CORS = WEB_BASE_URL.
# e.g. CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000
# CORS_ORIGINS=
# Public ws-gateway URL handed to desktop clients inside a ws-ticket.
WS_PUBLIC_URL=ws://localhost:3002
# Token / device-code lifetimes in SECONDS (optional — sane defaults applied).
# ACCESS_TOKEN_TTL=600
# REFRESH_TOKEN_TTL=2592000
# DEVICE_CODE_TTL=600
# DEVICE_CODE_INTERVAL=2
# WS_TICKET_TTL=60

# ---- Phase 1 (web — @cue/web, Next.js :3000) ----
# Canonical release feed (immutable manifest.json on R2/CloudFront). When unset,
# /api/latest-release serves the bundled static fallback manifest (local dev).
RELEASES_URL=
# Public site origin, used for canonical + OpenGraph URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Cue api BFF base URL the browser calls (device activation, /me, sessions).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# ---- Phase 2 (RAG — @cue/core embeddings + @cue/api DocumentsModule) ----
# Voyage AI key for voyage-3.5 embeddings (1024-d, document + query input types).
# Used by @cue/core VoyageEmbeddingsClient and the api DocumentsModule ingest.
VOYAGE_API_KEY=

# ---- Phase 2 (Billing — Stripe; @cue/api BillingModule + BillingWebhooksModule) ----
# Stripe secret key (sk_test_... in dev, sk_live_... in prod). Server-only.
STRIPE_SECRET_KEY=
# Stripe webhook signing secret (whsec_...); verified against the RAW request
# body in BillingWebhooksModule before any reconciliation runs.
STRIPE_WEBHOOK_SECRET=
# Stripe Price ids per tier (create in the Stripe dashboard / CLI).
#   PRO  — Pro flat monthly ($20). TEAM — Team per-seat monthly ($30).
#   OVERAGE — metered per-minute live-minute overage ($0.13/min) for Pro/Team.
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_OVERAGE=
# Optional Stripe Customer Portal configuration id (bpc_...). Pins the prices a
# user may switch between + proration behavior in the hosted Portal. Optional —
# when unset, Stripe uses the account's default Portal configuration.
STRIPE_PORTAL_CONFIG_ID=

# ---- Phase 3 (Enterprise SSO/SCIM — WorkOS; @cue/api SsoModule) ----
# WorkOS (@workos-inc/node) backs enterprise SSO/SAML + SCIM directory sync.
# The consumer OAuth2 PKCE path is unaffected. Server-only secrets.
# WorkOS API secret key (sk_test_... / sk_live_...).
WORKOS_API_KEY=
# WorkOS client id (client_...); used to build AuthKit/SAML authorization URLs.
WORKOS_CLIENT_ID=
# WorkOS webhook signing secret; verified against the RAW request body in the
# SCIM directory-sync webhook (POST /v1/scim/webhook) before provisioning.
WORKOS_WEBHOOK_SECRET=
# Absolute callback URL WorkOS redirects to after auth (GET /v1/sso/callback).
WORKOS_REDIRECT_URI=http://localhost:3001/v1/sso/callback

# ---- Phase 2 (Auto-update — apps/desktop electron-updater) ----
# INDEPENDENT update-manifest signing public key (minisign/base64), PINNED in
# the app and DISTINCT from the R2/S3 artifact-host credentials. The desktop
# app verifies the manifest signature against THIS key BEFORE sha512 + OS
# code-signature checks (05-remediation-plan). Never the artifact-host key.
UPDATE_MANIFEST_PUBLIC_KEY=

# ---- Phase 2 (Desktop packaging / code-signing — apps/desktop electron-builder) ----
# CI/release-only secrets, consumed by `pnpm --filter @cue/desktop package|publish`.
# Never populate these on a dev machine or commit real values — they live in the
# `desktop-release` CI environment (60-devops-infrastructure §7.2/§7.4).
#
# macOS notarization (build/notarize.cjs, via notarytool). When any are unset the
# afterSign hook SKIPS notarization instead of failing the build.
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=
# macOS code-signing identity (Developer ID Application .p12, base64 or path).
CSC_LINK=
CSC_KEY_PASSWORD=
# Windows code-signing cert (.pfx, base64 or path) + its password. electron-builder
# reads these WIN_-prefixed vars for the Windows target specifically.
WIN_CSC_LINK=
WIN_CSC_KEY_PASSWORD=

# ---- Desktop backend selection (apps/desktop) ----
# Which pipeline the Electron app runs:
#   local   (default) — Phase 0 in-process @cue/core (Deepgram + Claude direct).
#   gateway           — stream through ws-gateway (requires sign-in via PKCE).
CUE_BACKEND=local
# api BFF base URL the desktop authenticates + mints ws tickets against.
CUE_API_BASE_URL=http://localhost:3001
# Optional ws-gateway URL override; when unset the app uses the URL returned in
# the ws-ticket response (recommended).
CUE_WS_URL=
# Session kind created for a gateway session (interview_live | interview_prep |
# sales | support | meeting_notes).
CUE_SESSION_KIND=interview_live
# Whether the gateway session is disclosed to participants (true|false).
CUE_DISCLOSED=false
# ISO-639-1 language for the gateway session.
CUE_LANGUAGE=en

# ---- Phase 4 (Observability — @cue/observability, all services) ----
# OTLP/HTTP traces collector endpoint. Accepts a base (http://host:4318 — the
# /v1/traces path is appended) or a full traces URL. When unset, tracing still
# starts and exports to the OTel default (localhost:4318). Set OTEL_SDK_DISABLED
# =true to turn tracing off entirely (e.g. in unit tests).
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SDK_DISABLED=false
# Sentry DSN (server-side). When unset, initSentry() is a no-op (dev/test silent).
SENTRY_DSN=
# Optional Sentry release id (else falls back to build metadata / unset).
# SENTRY_RELEASE=
# pino log level (trace|debug|info|warn|error|fatal). Defaults to info.
# LOG_LEVEL=info
# Port the standalone /metrics server binds on for the non-Nest services
# (ws-gateway, ai-orchestrator). The api service serves /metrics on API_PORT via
# the ObservabilityModule, so this is only consumed by the gRPC/ws services.
METRICS_PORT=9464
# AWS region tag stamped on logs/metrics (also drives regional admission budgets).
# AWS_REGION=us-east-1

# ---- Phase 4 (Product analytics — PostHog) ----
# Server-side PostHog project key (posthog-node) for the typed event allowlist.
# Autocapture is OFF; only explicit non-PII events are emitted (61-observability
# §product-analytics). The browser key (apps/web) is NEXT_PUBLIC_POSTHOG_KEY.
POSTHOG_KEY=
# PostHog ingestion host (EU or US cloud, or self-hosted). e.g. https://eu.i.posthog.com
POSTHOG_HOST=https://eu.i.posthog.com

# ---- Phase 4 (apps/web browser telemetry — Sentry + PostHog) ----
# Client-exposed vars MUST be prefixed NEXT_PUBLIC_ to reach the browser bundle.
# All are optional: unset -> the web Sentry/PostHog init is a no-op and the site
# renders identically (dev/preview stay silent).
# Browser Sentry DSN (@sentry/nextjs client). Server render uses SENTRY_DSN above.
NEXT_PUBLIC_SENTRY_DSN=
# Optional explicit env label for browser events (else NODE_ENV).
# NEXT_PUBLIC_SENTRY_ENV=production
# Sentry build-plugin config (source-map upload). Optional; build succeeds without.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# Browser PostHog key + host (posthog-js). Autocapture/session-recording are OFF;
# text is masked and IP is not stored — only the typed non-PII event allowlist.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ---- Phase 4 (Reliability & scale — api + ws-gateway + ai-orchestrator) ----
# Control-Redis connection string (rate-limit counters, admission budgets — the
# latency-critical low-ops cluster, 70 §2.6). Optional: when unset the api rate
# limiter is DISABLED and fails OPEN (dev). e.g. redis://localhost:6379
REDIS_URL=
# api request rate limit, per authenticated user (falls back to client IP):
# RATE_LIMIT_MAX requests per RATE_LIMIT_WINDOW seconds. 429 (RATE_LIMITED) over.
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=120
# ws-gateway hard per-task ceiling on concurrent live WS connections (70 §2.1/§3).
# New sockets past this are rejected 1013; autoscaling targets ~60% of it. 0 = off.
WS_MAX_CONNECTIONS=5000
# Max wall-clock (ms) to drain in-flight WS connections on SIGTERM before force
# close (bounds ECS task stop on a connection-draining deploy, 70 §7).
# SHUTDOWN_DRAIN_MS=30000
# ai-orchestrator per-REGION admission budget (70 §2.3/§4.4, ADR-70.3): the
# ceilings THIS region meters against — never a shared global pool. CLAUDE_RPM_LIMIT
# is that region's Anthropic org RPM; STT_CONCURRENCY is its Deepgram concurrent-
# stream ceiling. 0 = admission gate disabled (dev). Effective session ceiling =
# min(STT_CONCURRENCY, CLAUDE_RPM_LIMIT / 4-cues-per-min).
CLAUDE_RPM_LIMIT=0
STT_CONCURRENCY=0
