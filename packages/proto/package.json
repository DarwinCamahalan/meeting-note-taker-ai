{
  "name": "@cue/proto",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cue gRPC contract: the orchestrator .proto plus a typed proto-loader client/server wrapper.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./orchestrator.proto": "./dist/orchestrator.proto"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').copyFileSync('src/orchestrator.proto','dist/orchestrator.proto')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.0",
    "@grpc/proto-loader": "^0.7.13"
  },
  "devDependencies": {
    "@cue/config": "workspace:*",
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  }
}
